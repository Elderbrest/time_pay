<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Profile photos use the Android Photo Picker (PickVisualMedia), which needs
         NO storage/media permission. We do not request broad media access. -->

    <!-- TimePay has no ads. Firebase Analytics auto-adds the advertising-ID
         permission; we remove it so the app does not request/use the ad ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />

    <!-- Glide/transitive libs may pull these media permissions in; remove them so
         the bundle does not declare restricted photo/video access (Play policy). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- localeConfig is read by the platform only on API 33+, which is what lint's
         UnusedAttribute flags. It is still correct to declare at minSdk 26: below 33
         the framework ignores it and AppCompat applies the in-app language itself,
         while on 33+ this is what populates Settings -> Apps -> TimePay -> Language. -->
    <application
        android:name=".TimePayApplication"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        tools:ignore="UnusedAttribute"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimePay"
        tools:targetApi="31">
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.TimePay.Login" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.TimePay.Login" />
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.TimePay.Login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.TimePay.Login" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>