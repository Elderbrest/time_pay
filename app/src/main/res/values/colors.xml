<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        TimePay color palette — light mode.
        Hex values for primary/secondary/surface/on-surface come from DESIGN.md §2.
        Container/inverse derivations follow M3 conventions:
          - *_container ≈ tonal lighten of base toward 90% L (kept perceptually muted)
          - on_*_container ≈ tonal darken of base toward 10% L (kept readable on container)
        Each derivation is annotated for review.
    -->

    <!-- Utility constants (kept for backward compat with raw refs) -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Primary: deep forest green (DESIGN.md §2 exact). -->
    <color name="md_primary">#2E5D4F</color>
    <color name="md_on_primary">#FFFFFFFF</color>
    <!-- primary_container: lightened forest green (~90% L), still in family. -->
    <color name="md_primary_container">#B7E1D2</color>
    <!-- on_primary_container: darkened forest green (~10% L) for contrast. -->
    <color name="md_on_primary_container">#0F2620</color>

    <!-- Secondary: warm amber, reserved for earnings (DESIGN.md §2 exact). -->
    <color name="md_secondary">#C97B3D</color>
    <color name="md_on_secondary">#FFFFFFFF</color>
    <!-- secondary_container: light amber wash (~90% L). -->
    <color name="md_secondary_container">#F6DCC5</color>
    <!-- on_secondary_container: deep amber (~15% L) for readable label-on-chip. -->
    <color name="md_on_secondary_container">#3B1F0A</color>

    <!-- Tertiary: warm hazel-brown (TimePay System / v2 exact).
         Provides a warm counterpoint to the forest primary and ties to the
         "bespoke stationery" warmth of the v2 design system. -->
    <color name="md_tertiary">#5E312A</color>
    <color name="md_on_tertiary">#FFFFFFFF</color>
    <color name="md_tertiary_container">#794740</color>
    <color name="md_on_tertiary_container">#FCB9AF</color>

    <!-- Surface / background (v2 exact).
         v2 uses a single off-white (#F9FAF7) base for both surface and background
         — a softer, more "paper-like" reading surface than pure white. Card
         elevation is expressed through the surface-container tonal ladder below. -->
    <color name="md_surface">#F9FAF7</color>
    <color name="md_on_surface">#1A1C1B</color>
    <!-- surface_variant: subtle wash for cards/dividers. -->
    <color name="md_surface_variant">#E2E3E0</color>
    <!-- on_surface_variant — used for secondary text. -->
    <color name="md_on_surface_variant">#404945</color>

    <color name="md_background">#F9FAF7</color>
    <color name="md_on_background">#1A1C1B</color>

    <!-- Surface-container tonal ladder (v2 exact). Replaces drop shadows:
         depth is expressed by stepping cards up this ladder rather than lifting. -->
    <color name="md_surface_dim">#D9DAD8</color>
    <color name="md_surface_bright">#F9FAF7</color>
    <color name="md_surface_container_lowest">#FFFFFF</color>
    <color name="md_surface_container_low">#F3F4F1</color>
    <color name="md_surface_container">#EDEEEC</color>
    <color name="md_surface_container_high">#E7E8E6</color>
    <color name="md_surface_container_highest">#E2E3E0</color>

    <!-- Inverse surfaces (v2 exact) — used by snackbars / inverse components. -->
    <color name="md_inverse_surface">#2E312F</color>
    <color name="md_inverse_on_surface">#F0F1EE</color>

    <!-- Error (v2 exact for destructive surfaces). -->
    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#93000A</color>

    <!-- Outline tokens for borders/dividers (v2 exact). -->
    <color name="md_outline">#707975</color>
    <color name="md_outline_variant">#C0C8C4</color>

    <!-- Backward-compat references — keep names, redirect to semantic tokens. -->
    <color name="calendar_day_active">@color/md_on_surface</color>
    <color name="calendar_day_inactive">@color/md_on_surface_variant</color>
</resources>
