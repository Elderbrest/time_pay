<?xml version="1.0" encoding="utf-8"?>
<!--
    Edit-note dialog body.
    Wrapped in TextInputLayout per DESIGN.md §3 widget audit. The inner
    TextInputEditText keeps the existing id (@id/noteEditText) so
    CalendarFragment's `findViewById<EditText>(R.id.noteEditText)` still
    resolves (TextInputEditText extends EditText).
-->
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_16"
    android:hint="@string/calendar_note_title"
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    app:boxCornerRadiusBottomEnd="@dimen/radius_card"
    app:boxCornerRadiusBottomStart="@dimen/radius_card"
    app:boxCornerRadiusTopEnd="@dimen/radius_card"
    app:boxCornerRadiusTopStart="@dimen/radius_card">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/noteEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:inputType="textMultiLine|textCapSentences"
        android:gravity="top|start" />

</com.google.android.material.textfield.TextInputLayout>
