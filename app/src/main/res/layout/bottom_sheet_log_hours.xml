<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainerLowest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_24">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />

        <!-- Header row: date title + status chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sheetDateTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                tools:text="Thursday, 18 June" />

            <TextView
                android:id="@+id/sheetStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="@dimen/space_4"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Done"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Intent toggle: Log hours / Plan day -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sheetIntentToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheetBtnLog"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/log_sheet_intent_log" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheetBtnPlan"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/log_sheet_intent_plan" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Times block (Log mode only) -->
        <LinearLayout
            android:id="@+id/sheetTimesBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheetStartBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_8"
                tools:text="Start 09:00" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheetEndBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_8"
                tools:text="End 18:00" />
        </LinearLayout>

        <!-- Plan mode caption -->
        <TextView
            android:id="@+id/sheetPlanCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="@string/log_sheet_plan_caption"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Live earnings preview -->
        <TextView
            android:id="@+id/sheetEarningsPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/md_on_secondary_container"
            tools:text="= PLN 920" />

        <!-- Note input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/sheetNoteInput"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/calendar_note_title"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/sheetNoteEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="80dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Edit note toggle button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetEditNoteBtn"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_sheet_edit_note"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Primary action button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetPrimaryBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_16"
            android:backgroundTint="@color/md_primary"
            android:textColor="@color/white"
            tools:text="Log 8h" />

        <!-- Remove this day -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetRemoveBtn"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/log_sheet_remove"
            android:textColor="@color/md_error"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
