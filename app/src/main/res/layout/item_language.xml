<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- The clickable target, not the root: the root also holds the "System default"
         divider, which must sit outside the ripple. Bound by id in the adapter, because
         a clickable child would otherwise swallow touches before they reach itemView. -->
    <LinearLayout
        android:id="@+id/languageRowContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_12">

        <!-- The endonym: the one label a user who cannot read the current UI language
             can still recognise. Set at bind time, so no android:text here. -->
        <TextView
            android:id="@+id/languageNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Español" />

        <TextView
            android:id="@+id/languageSelectedMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/currency_selected_mark"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Only shown under "System default", separating the recommended row from the
         explicit language list below it. -->
    <View
        android:id="@+id/languageDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
