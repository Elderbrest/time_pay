<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        TimePay base theme — Material 3, dark variant.
        Color tokens resolve to values-night/colors.xml automatically;
        we keep theme attrs identical and only override the system-bar
        appearance for dark mode (icons stay light on dark surfaces).
    -->
    <style name="Theme.TimePay" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <!-- Surface / Background -->
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>

        <!-- Error -->
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- System bars: transparent, draw under, light icons (dark mode). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>

        <!-- Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.TimePay.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.TimePay.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.TimePay.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.TimePay.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.TimePay.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.TimePay.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.TimePay.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.TimePay.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.TimePay.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.TimePay.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.TimePay.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.TimePay.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.TimePay.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.TimePay.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.TimePay.LabelSmall</item>

        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="Theme.TimePay.Login" parent="Theme.TimePay" />
</resources>
