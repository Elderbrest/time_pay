    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38.5,37 H69.5 A6.5,6.5 0 0 1 69.5,50 H38.5 A6.5,6.5 0 0 1 38.5,37 Z" />

    <!-- Vertical stem of the T (rounded bottom) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M47,37 H61 V73.5 A6.5,6.5 0 0 1 47,73.5 Z" />
</vector>
