rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user profile document.
    // Used by UserRepository to read/write users/{uid}.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Per-user calendar subcollection.
    // Used by CalendarDayRepository to read/write users/{uid}/calendar/{yyyy-MM-dd}
    // and to run a documentId range query for the current month.
    match /users/{userId}/calendar/{date} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else: implicit deny.
  }
}
